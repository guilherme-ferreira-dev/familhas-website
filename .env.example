# Familhas: variáveis de ambiente do ambiente local.
#
# Copie para .env na raiz (cp .env.example .env). O .env é ignorado pelo Git e nunca deve ser commitado.
# Valor vazio = o docker compose usa o padrão local definido em infra/docker-compose.yml.
# Nunca coloque aqui credenciais reais de produção.
#
# A familhas-api roda fora do compose (./mvnw spring-boot:run) e não lê este arquivo sozinha.
# Para usar outros valores nela, exporte as variáveis no shell antes de subir.

# --- Oracle (compose) ---
ORACLE_PASSWORD=
ORACLE_DATABASE=
ORACLE_APP_USER=
ORACLE_APP_USER_PASSWORD=
ORACLE_PORT=

# --- RabbitMQ (compose, familhas-api e familhas-email) ---
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=
# Só para a familhas-api fora do compose
RABBITMQ_HOST=
RABBITMQ_VHOST=

# --- Keycloak (compose) ---
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_URL=
KEYCLOAK_DB_USERNAME=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_SCHEMA=
KEYCLOAK_HOSTNAME=
KEYCLOAK_HTTPS_PORT=
KEYCLOAK_HTTPS_KEY_STORE_FILE=
KEYCLOAK_HTTPS_KEY_STORE_PASSWORD=
KEYCLOAK_HTTPS_KEY_STORE_TYPE=
KEYCLOAK_CORS_ALLOWED_ORIGINS=

# --- MailHog (compose) ---
MAILHOG_SMTP_PORT=
MAILHOG_UI_PORT=

# --- familhas-api ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=
KEYCLOAK_AUDIENCE=
CORS_ALLOWED_ORIGINS=
# Outbox (ADR 0005)
OUTBOX_PUBLISHER_ENABLED=
OUTBOX_FIXED_DELAY=
OUTBOX_BATCH_SIZE=
OUTBOX_CONFIRM_TIMEOUT=
OUTBOX_MAX_ATTEMPTS=
OUTBOX_RETRY_BACKOFF=
OUTBOX_MAX_RETRY_BACKOFF=
# Provedores (ADR 0006). PROVIDERS_MOCK_ENABLED=true liga ofertas simuladas para o frontend
PROVIDERS_MOCK_ENABLED=
PROVIDERS_CACHE_TTL=
PROVIDERS_CACHE_MAX_SIZE=
PROVIDERS_TIMEOUT=
PROVIDERS_CIRCUIT_OPEN_WAIT=
# Preço (ADR 0006): padrão de margem e taxa. O que for salvo no Admin (pricing_settings, ADR 0011) vale mais
PRICING_MARGIN_PERCENT=
PRICING_SERVICE_FEE_PER_PASSENGER=
PRICING_SERVICE_FEE_CURRENCY=
# Admin (ADR 0011): planilha de pagamentos em tempo real (fila anônima em payment.#) e prazo de requisição
# assíncrona (exportação XLSX/CSV), ISO-8601
ADMIN_PAYMENT_FEED_ENABLED=
MVC_ASYNC_REQUEST_TIMEOUT=
# Validade da cotação (ISO-8601, ex.: PT24H)
QUOTE_VALIDITY=
# Reserva e pagamento (ADR 0007). Só chaves de TESTE do Stripe: a API recusa chave live.
# Sem STRIPE_SECRET_KEY a API sobe e o checkout responde 503. O whsec_ vem do "stripe listen".
BOOKING_PAYMENT_WINDOW=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
STRIPE_TIMEOUT=
STRIPE_MAX_NETWORK_RETRIES=
STRIPE_PIX_ENABLED=
FAMILHAS_WEB_BASE_URL=
CHECKOUT_SESSION_TTL=
PAYMENTS_RECONCILIATION_ENABLED=
PAYMENTS_RECONCILIATION_FIXED_DELAY=
PAYMENTS_RECONCILIATION_STALE_AFTER=

# --- familhas-email (ADR 0005) ---
# Usuário/schema próprio no Oracle, criado por infra/oracle/init/02-create-familhas-email-user.sh
EMAIL_DB_USERNAME=
EMAIL_DB_PASSWORD=
# Só para rodar o familhas-email fora do compose
EMAIL_DB_URL=
EMAIL_SERVER_PORT=
# SMTP: vazio = MailHog (http://localhost:8025). Para enviar a um e-mail real pelo Gmail:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true,
#   SMTP_USERNAME=<sua conta gmail>, SMTP_PASSWORD=<senha de app de 16 letras, sem espaços>,
#   EMAIL_FROM="Familhas <sua conta gmail>" (o Gmail troca qualquer outro remetente pela conta).
# Depois de mudar: docker compose up -d --build familhas-email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
# true só para diagnóstico: loga a conversa SMTP, com endereços (LGPD)
SMTP_DEBUG=
EMAIL_FROM=
EMAIL_RETRY_MAX_ATTEMPTS=
EMAIL_RETRY_INITIAL_INTERVAL=
EMAIL_RETRY_MULTIPLIER=
EMAIL_RETRY_MAX_INTERVAL=
